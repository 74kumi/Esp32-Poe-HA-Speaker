(version 1)
# Preliminary 3 mm review target; not an insulation certification.
(rule "PoE primary to secondary review target"
 (condition "A.NetName != '' && B.NetName != '' && (((A.NetName == 'POE_RECT_POS' || A.NetName == 'POE_RECT_NEG' || A.NetName == 'POE_MODE_A_AC1' || A.NetName == 'POE_MODE_A_AC2' || A.NetName == 'POE_MODE_B_AC1' || A.NetName == 'POE_MODE_B_AC2' || A.NetName == 'AT_DET_PRIMARY' || A.NetName == 'BT3_DET_PRIMARY' || A.NetName == 'BT4_DET_PRIMARY' || A.NetName == 'AT_LED_A' || A.NetName == 'BT3_LED_A' || A.NetName == 'BT4_LED_A') && !(B.NetName == 'POE_RECT_POS' || B.NetName == 'POE_RECT_NEG' || B.NetName == 'POE_MODE_A_AC1' || B.NetName == 'POE_MODE_A_AC2' || B.NetName == 'POE_MODE_B_AC1' || B.NetName == 'POE_MODE_B_AC2' || B.NetName == 'AT_DET_PRIMARY' || B.NetName == 'BT3_DET_PRIMARY' || B.NetName == 'BT4_DET_PRIMARY' || B.NetName == 'AT_LED_A' || B.NetName == 'BT3_LED_A' || B.NetName == 'BT4_LED_A')) || ((B.NetName == 'POE_RECT_POS' || B.NetName == 'POE_RECT_NEG' || B.NetName == 'POE_MODE_A_AC1' || B.NetName == 'POE_MODE_A_AC2' || B.NetName == 'POE_MODE_B_AC1' || B.NetName == 'POE_MODE_B_AC2' || B.NetName == 'AT_DET_PRIMARY' || B.NetName == 'BT3_DET_PRIMARY' || B.NetName == 'BT4_DET_PRIMARY' || B.NetName == 'AT_LED_A' || B.NetName == 'BT3_LED_A' || B.NetName == 'BT4_LED_A') && !(A.NetName == 'POE_RECT_POS' || A.NetName == 'POE_RECT_NEG' || A.NetName == 'POE_MODE_A_AC1' || A.NetName == 'POE_MODE_A_AC2' || A.NetName == 'POE_MODE_B_AC1' || A.NetName == 'POE_MODE_B_AC2' || A.NetName == 'AT_DET_PRIMARY' || A.NetName == 'BT3_DET_PRIMARY' || A.NetName == 'BT4_DET_PRIMARY' || A.NetName == 'AT_LED_A' || A.NetName == 'BT3_LED_A' || A.NetName == 'BT4_LED_A')))")
 (constraint clearance (min 3mm))
)
